# Copy this file to .env and fill in real values.
# Never commit the real .env file to version control.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=listrix_user
DB_PASSWORD=change-this-password
DB_NAME=listrix_db

# --- Admin key for POST/PUT/DELETE /api/knowledge ---
# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-this-to-a-long-random-value

# --- CORS: comma-separated list of allowed origins ---
CORS_ORIGINS=https://listoradigitalmedia.com,https://www.listoradigitalmedia.com

# --- Rate limiting (slowapi syntax) ---
CHAT_RATE_LIMIT=20/minute
CONTACT_RATE_LIMIT=10/minute

ENVIRONMENT=production
